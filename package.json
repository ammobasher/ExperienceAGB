{
  "name": "experience-agb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Local-first exploratory viewer for Adaptive Gradient Boosting model exports",
  "author": "ExperienceAGB contributors",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:local": "node scripts/ai-host.mjs",
    "test:server": "node --test scripts/preview-host.test.mjs scripts/ai-host.test.mjs scripts/copilot.test.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "desktop:build": "npm run build && node desktop/build.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:package:win": "node desktop/package.mjs win32 x64",
    "desktop:package:mac:intel": "node desktop/package.mjs darwin x64",
    "desktop:package:mac:apple": "node desktop/package.mjs darwin arm64",
    "test:desktop:unit": "node --test desktop/policy.test.mjs desktop/credentials.test.mjs",
    "test:desktop": "node desktop/smoke.mjs",
    "test:desktop:packaged": "node desktop/packaged-smoke.mjs",
    "test:desktop:runtime": "node desktop/runtime-smoke.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.21",
    "d3-hierarchy": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}